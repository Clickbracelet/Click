n', mins: 5, when: '5 minutes ago', about: 'Founded Click. Electro-pop musician who writes, sings, and produces her own music. Startup founder, marketing, entrepreneur.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@audreyguinn', action: 'Follow' }, { key: 'li', plat: 'LinkedIn', handle: 'Audrey Guinn Stephenson', action: 'Connect' }, { key: 'web', plat: 'Click Website', handle: 'clickbracelet.com', action: 'Visit' }] },\\n  { id: 'chloe', name: 'Chloe Malone', desc: 'Liberal Studies, Cal Poly · Flag Football #4 · Loves reading', photo: PH.chloe, years: null, hair: 'blonde', loc: 'Doerr Family Field, Cal Poly', event: '', mins: 20, when: '20 minutes ago', about: 'Liberal Studies major on the flag football team who loves reading books.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@chloeemalone', action: 'Follow' }, { key: 'tt', plat: 'TikTok', handle: '@chloe.brynn', action: 'Follow' }, { key: 'sc', plat: 'Snapchat', handle: 'chloemalone4', action: 'Add' }] },\\n  { id: 'leila', name: 'Leila Butler', desc: 'Landscape Architecture, Cal Poly · Flag Football #15 · Social Media Manager', photo: PH.leila, years: null, hair: 'brown', loc: 'Doerr Family Field, Cal Poly', event: '', mins: 22, when: '22 minutes ago', about: 'Surfs, draws, and runs the flag football team social media.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@leilatani12', action: 'Follow' }, { key: 'tt', plat: 'TikTok', handle: '@leilatani', action: 'Follow' }, { key: 'sc', plat: 'Snapchat', handle: 'leilabutler12', action: 'Add' }] },\\n  { id: 'payton', name: 'Payton Stern', desc: 'Interdisciplinary Studies, Cal Poly · Flag Football #3 · Outdoors', photo: PH.payton, years: null, hair: 'brown', loc: 'Doerr Family Field, Cal Poly', event: '', mins: 24, when: '24 minutes ago', about: 'Loves spending time outdoors and hiking.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@payton.sternn', action: 'Follow' }, { key: 'tt', plat: 'TikTok', handle: '@payton_stern', action: 'Follow' }, { key: 'sc', plat: 'Snapchat', handle: 'paytonsternn', action: 'Add' }] },\\n  { id: 'sadie', name: 'Sadie Roney', desc: 'Wine & Viticulture, Cal Poly · Flag Football #5 · Beach & Travel', photo: PH.sadie, years: null, hair: 'blonde', loc: 'Doerr Family Field, Cal Poly', event: '', mins: 26, when: '26 minutes ago', about: 'Loves sports, the beach, and traveling.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@sadie_roney', action: 'Follow' }, { key: 'sc', plat: 'Snapchat', handle: 'sadieroney', action: 'Add' }] },\\n  { id: 'lola', name: 'Lola Acosta', desc: 'Liberal Studies, Cal Poly · Flag Football #22 · Surfer', photo: PH.lola, years: null, hair: 'blonde', loc: 'Doerr Family Field, Cal Poly', event: '', mins: 28, when: '28 minutes ago', about: 'Loves playing sports, surfing, and any kind of exercise or workout.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@lolabelle.22', action: 'Follow' }, { key: 'tt', plat: 'TikTok', handle: '@lolasspamzz22', action: 'Follow' }, { key: 'sc', plat: 'Snapchat', handle: 'lola.belle22', action: 'Add' }] },\\n  { id: 'priya', name: 'Priya Patel', desc: 'Design major · Runner · Plant parent', photo: '', years: 19, hair: 'black', loc: 'Cal Poly, San Luis Obispo', event: 'Startup Launch Weekend', mins: 300, when: 'Today, 11:40 AM', about: 'Graphic design, running, plants.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@priya.designs', action: 'Follow' }, { key: 'sc', plat: 'Snapchat', handle: 'priyap', action: 'Add' }] },\\n  { id: 'marcus', name: 'Marcus Lee', desc: 'Film student · Surfer · Coffee snob', photo: '', years: 20, hair: 'black', loc: 'Cal Poly, San Luis Obispo', event: 'Cal Poly Career Fair', mins: 1500, when: 'Yesterday, 4:10 PM', about: 'Film, acting, surfing, coffee.', socials: [{ key: 'li', plat: 'LinkedIn', handle: 'Marcus Lee', action: 'Connect' }, { key: 'web', plat: 'Website', handle: 'marcuslee.film', action: 'Visit' }] },\\n  { id: 'jordan', name: 'Jordan Reyes', desc: 'Electrical Engineering · Climber · DJ', photo: '', years: 21, hair: 'red', loc: 'Avila Beach', event: '', mins: 4400, when: '3 days ago', about: 'Electrical engineering, circuits, climbing, DJ music.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@jordan.reyes', action: 'Follow' }, { key: 'sc', plat: 'Snapchat', handle: 'jreyes', action: 'Add' }] },\\n  { id: 'sam', name: 'Sam Chen', desc: 'Marketing · Foodie · Runner', photo: '', years: 22, hair: 'black', loc: 'San Luis Obispo', event: 'CPE Mixer', mins: 14000, when: 'Oct 30', about: 'Marketing, food, running, entrepreneurship.', socials: [{ key: 'li', plat: 'LinkedIn', handle: 'Sam Chen', action: 'Connect' }, { key: 'ig', plat: 'Instagram', handle: '@samchen.eats', action: 'Follow' }] },\\n  { id: 'taylor', name: 'Taylor Brooks', desc: 'Musician · Barista · Thrifter', photo: '', years: 19, hair: 'red', loc: 'Downtown San Luis Obispo', event: 'Open mic night', mins: 100000, when: 'Sep 2', about: 'Singer songwriter, coffee, thrifting, books and poetry.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@taylorbrooks', action: 'Follow' }, { key: 'sp', plat: 'Spotify', handle: 'Taylor Brooks', action: 'Listen' }] },\\n  { id: 'lee', name: 'Lee Park', desc: 'Architecture · Surfer · Photographer', photo: '', years: 23, hair: 'brown', loc: 'Pismo Beach', event: '', mins: 290000, when: 'Jan 24', about: 'Architecture, surfing, photography.', socials: [{ key: 'ig', plat: 'Instagram', handle: '@leepark.photo', action: 'Follow' }, { key: 'web', plat: 'Website', handle: 'leepark.studio', action: 'Visit' }] }\\n];\\n\\n// ---- Ask Click: reads every Click's profile, photo traits, place and time ----\\nconst ASK_GROUPS = [\\n  ['read','reads','reading','reader','book','books','bookworm','novel','novels','literature','poetry','library'],\\n  ['surf','surfer','surfing','waves'],\\n  ['beach','ocean','coast'],\\n  ['music','musician','sing','singer','songwriter','dj','band','producer','produces','electro-pop'],\\n  ['film','actor','acting','acts','theater','theatre','drama','movie','movies'],\\n  ['electrical','engineering','engineer','circuits','circuit','hardware'],\\n  ['develop','developer','code','coding','software','app'],\\n  ['design','designer','graphic','architecture','architect','landscape'],\\n  ['art','artist','draw','draws','drawing','photography','photographer','photo'],\\n  ['marketing','social','media','content','brand','founder','startup','entrepreneur','entrepreneurship','business'],\\n  ['outdoors','outdoor','hike','hiking','nature','camping','climb','climber','climbing'],\\n  ['exercise','workout','gym','fitness','run','runner','running','sports','football','athlete'],\\n  ['travel','traveling','trip','trips','adventure'],\\n  ['wine','viticulture','vineyard'],\\n  ['coffee','barista','food','foodie','cook','cooking'],\\n  ['plants','plant','garden','gardening'],\\n  ['thrift','thrifter','thrifting','fashion','jewelry']\\n];\\nconst ASK_LABELS = ['reading','surfing','the beach','music','film and acting','electrical engineering','coding','design','art','marketing and business','the outdoors','working out','travel','wine','coffee and food','plants','fashion'];\\nconst ASK_STOP = 'who whos is are was were do does did i im me my anyone anybody someone people person that the a an any can could with in of and or to for about like likes into know knew met meet all every everyone show find list pull up give tell what which their there has have had invite bring go hang out new fun club group friend friends should would be been get old years year yrs aged age hair at from on this last past today yesterday week month contact contacts click clicks clicked thats whats it its im over under than older younger above below person persons anything something stuff'.split(' ');\\nconst HAIR = { red: ['red','ginger','auburn','redhead','redheads','redheaded'], blonde: ['blonde','blond','blondes'], brown: ['brown','brunette','brunettes'], black: ['black'] };\\nconst tok = (t) => String(t || '').toLowerCase().replace(/work(ing)?\\\\s*out/g, 'workout').replace(/book\\\\s*club/g, 'books').replace(/[^a-z0-9\\\\s-]/g, ' ').split(/\\\\s+/).filter(Boolean);\\nconst stem = (w) => (w.length > 4 ? w.replace(/(ings|ing|ers|er|es|s)$/, '') : w);\\nconst expandTerm = (t) => { let out = [t]; ASK_GROUPS.forEach((g) => { if (g.some((x) => stem(x) === stem(t))) out = out.concat(g); }); return out; };\\nconst hitWord = (words, opts) => words.some((w) => opts.some((o) => w === o || stem(w) === stem(o) || (stem(o).length >= 5 && w.indexOf(stem(o)) === 0)));\\n\\nfunction askClick(q, people) {\\n  const ql = ' ' + String(q).toLowerCase() + ' ';\\n  const words = tok(q);\\n  const used = {};\\n  const filters = []; // { label, test(p) -> reason|false }\\n  // Age\\n  let m = ql.match(/(?:over|older than|above)\\\\s+(\\\\d{2})/);\\n  if (m) { const n = +m[1]; used[m[1]] = 1; filters.push({ label: 'are over ' + n, test: (p) => p.years != null && p.years > n ? p.years + ' years old' : false }); }\\n  m = ql.match(/(?:under|younger than|below)\\\\s+(\\\\d{2})/);\\n  if (m) { const n = +m[1]; used[m[1]] = 1; filters.push({ label: 'are under ' + n, test: (p) => p.years != null && p.years < n ? p.years + ' years old' : false }); }\\n  if (!filters.length) {\\n    m = ql.match(/\\\\b(\\\\d{2})\\\\s*(?:yrs?|years?|y\\\\/?o|-?year-?olds?)\\\\b/) || (/\\\\b(old|age|aged)\\\\b/.test(ql) ? ql.match(/\\\\b(\\\\d{2})\\\\b/) : null) || ql.match(/\\\\b(?:is|are|turning)\\\\s+(\\\\d{2})\\\\b/);\\n    if (m) { const n = +m[1]; used[m[1]] = 1; filters.push({ label: 'are ' + n, test: (p) => p.years === n ? p.years + ' years old' : false }); }\\n  }\\n  // Hair (read from profile photos)\\n  Object.keys(HAIR).forEach((color) => {\\n    const hit = HAIR[color].find((w) => words.indexOf(w) > -1);\\n    if (hit && (ql.indexOf('hair') > -1 || /red ?head|ginger|blond|brunette/.test(ql))) {\\n      HAIR[color].forEach((w) => { used[w] = 1; });\\n      filters.push({ label: 'have ' + color + ' hair', test: (p) => p.hair === color ? color.charAt(0).toUpperCase() + color.slice(1) + ' hair, from their profile photo' : false });\\n    }\\n  });\\n  // When\\n  const T = [\\n    [/last hour|past hour|this hour/, 0, 60, 'you clicked with in the last hour'],\\n    [/\\\\btoday\\\\b|this morning|this afternoon|tonight/, 0, 720, 'you clicked with today'],\\n    [/yesterday/, 720, 2880, 'you clicked with yesterday'],\\n    [/this week|past week|last week/, 0, 10080, 'you clicked with this week'],\\n    [/this month|past month|last month/, 0, 43200, 'you clicked with this month']\\n  ];\\n  T.forEach((t) => { if (t[0].test(ql)) filters.push({ label: t[3], test: (p) => p.mins >= t[1] && p.mins <= t[2] ? 'Clicked ' + p.when.replace(/^([A-Z])/, (c) => c.toLowerCase()) : false }); });\\n  // Where\\n  const placeOf = (p) => (p.event ? p.event + ', ' : '') + p.loc;\\n  const GENERIC = ['cal','poly','san','luis','obispo','the','field','family','night','weekend'];\\n  const placeWords = {};\\n  people.forEach((p) => tok(placeOf(p)).forEach((w) => { if (w.length > 2 && GENERIC.indexOf(w) < 0) placeWords[w] = 1; }));\\n  words.forEach((w) => { if (GENERIC.indexOf(w) > -1 && /\\\\b(at|in|from|near)\\\\b/.test(ql)) used[w] = 1; });\\n  const wantPlace = words.filter((w) => placeWords[w] && !used[w] && /\\\\b(at|in|from|near)\\\\b/.test(ql) || (placeWords[w] && ['doerr','hackathon','avila','pismo','mixer','downtown','fair','mic'].indexOf(w) > -1));\\n  if (wantPlace.length) {\\n    wantPlace.forEach((w) => { used[w] = 1; });\\n    const pf = { label: 'you met there', test: (p) => { const pw = tok(placeOf(p)); if (!wantPlace.every((w) => pw.indexOf(w) > -1)) return false; pf.label = 'you met at ' + placeOf(p); return 'Met at ' + placeOf(p); } };\\n    filters.push(pf);\\n  }\\n  // Interests (profile + what they share on socials)\\n  const corpus = {};\\n  people.forEach((p) => tok(p.desc + ' ' + p.about).forEach((w) => { corpus[stem(w)] = 1; }));\\n  const known = (w) => corpus[stem(w)] || ASK_GROUPS.some((g) => g.some((x) => stem(x) === stem(w)));\\n  const terms = words.filter((w) => !used[w] && ASK_STOP.indexOf(w) < 0 && w.length > 1 && !/^\\\\d+$/.test(w) && !HAIR.red.concat(HAIR.blonde, HAIR.brown, HAIR.black).includes(w) && !placeWords[w] && known(w));\\n  if (terms.length) {\\n    const nice = terms.map((t) => { const gi = ASK_GROUPS.findIndex((g) => g.some((x) => stem(x) === stem(t))); return gi > -1 ? ASK_LABELS[gi] : t; }).filter((v, i, a) => a.indexOf(v) === i);\\n    filters.push({ label: 'are into ' + nice.join(' and '), test: (p) => {\\n      const txt = p.desc + '. ' + p.about;\\n      const ok = terms.some((t) => hitWord(tok(txt), expandTerm(t)));\\n      if (!ok) return false;\\n      const all = []; terms.forEach((t) => { all.push.apply(all, expandTerm(t)); });\\n      const part = txt.split(/\\\\s*[·.]\\\\s*/).find((seg) => hitWord(tok(seg), all)) || p.desc;\\n      return part.trim();\\n    } });\\n  }\\n  const everyone = /\\\\b(everyone|everybody|all my|list all|show all)\\\\b/.test(ql);\\n  if (!filters.length && !everyone) {\\n    return { text: 'I can find people by age, hair color in their photo, where or when you met, and anything they shared, like reading or surfing. Try one of the suggestions below.', people: [] };\\n  }\\n  const found = [];\\n  people.forEach((p) => {\\n    const reasons = [];\\n    for (let i = 0; i < filters.length; i++) { const r = filters[i].test(p); if (!r) return; reasons.push(r); }\\n    found.push({ id: p.id, reason: reasons.length ? reasons.join(' · ') : (p.when) });\\n  });\\n  const desc = filters.map((f) => f.label).join(' and ');\\n  if (!found.length) return { text: 'I couldn\\\\'t find anyone who ' + (desc || 'matches that') + ' yet. Keep clicking, or try another question.', people: [] };\\n  const n = found.length;\\n  const desc2 = filters.map((f) => f.label).join(' and ');\\n  const lead = everyone && !filters.length ? 'Here are all ' + n + ' of your Clicks.' : (n === 1 ? 'I found 1 person who ' + desc2.replace(/\\\\bare\\\\b/g, 'is').replace(/\\\\bhave\\\\b/g, 'has') : 'I found ' + n + ' people who ' + desc2) + '.';\\n  const leadText = lead.replace(' who you ', ' you ');\\n  return { text: leadText + ' Tap anyone to open their Click.', people: found };\\n}\\n\\nclass Component extends DCLogic {\\n  constructor(props) {\\n    super(props);\\n    this.state = {\\n      screen: 'welcome',\\n      fromSettings: false,\\n      pairState: 'idle',\\n      photo: '',\\n      profName: '',\\n      tag1: '', tag2: '', tag3: '',\\n      profBio: '',\\n      on: {},\\n      handles: {},\\n      customLinks: [],\\n      presets: [\\n        { id: 'party', name: 'Party', plats: ['ig', 'sc'], custom: false },\\n        { id: 'network', name: 'Networking', plats: ['li', 'web'], custom: false },\\n        { id: 'everyday', name: 'Everyday', plats: ['ig', 'tt'], custom: false }\\n      ],\\n      activePreset: 'party',\\n      editId: null, editName: '', editPlats: {}, editReturn: 'presets', editError: false,\\n      filter: 'year',\\n      selectedId: null,\\n      events: {}, notes: {}, removed: {},\\n      editingLoc: false, locDraft: '',\\n      currentEvent: '', eventDur: '4h', winStart: '18:00', winEnd: '22:00', winTz: 'PT',\\n      sound: true, locked: false,\\n      expandedId: null, noteOpenId: null,\\n      chat: [], chatDraft: '', asking: false\\n    };\\n  }\\n\\n  componentWillUnmount() { clearTimeout(this.pairTimer); clearTimeout(this.askTimer); }\\n\\n  ask(q) {\\n    const text = String(q || '').trim();\\n    if (!text || this.state.asking) return;\\n    const people = CLICK_DATA.filter((p) => !this.state.removed[p.id]);\\n    this.setState({ chat: this.state.chat.concat([{ from: 'me', text: text }]), chatDraft: '', asking: true });\\n    clearTimeout(this.askTimer);\\n    this.askTimer = setTimeout(() => {\\n      const a = askClick(text, people);\\n      this.setState({ chat: this.state.chat.concat([{ from: 'bot', text: a.text, people: a.people }]), asking: false });\\n    }, 650);\\n  }\\n\\n  renderVals() {\\n    const s = this.state;\\n    const set = (patch) => () => this.setState(patch);\\n\\n    const PLATFORMS = [\\n      { id: 'ig', name: 'Instagram', badge: 'IG', ph: '@username' },\\n      { id: 'tt', name: 'TikTok', badge: 'TT', ph: '@username' },\\n      { id: 'sc', name: 'Snapchat', badge: 'SC', ph: 'username' },\\n      { id: 'li', name: 'LinkedIn', badge: 'in', ph: 'linkedin.com/in/yourname' },\\n      { id: 'x', name: 'X', badge: 'X', ph: '@username' },\\n      { id: 'fb', name: 'Facebook', badge: 'f', ph: 'facebook.com/yourname' },\\n      { id: 'yt', name: 'YouTube', badge: 'YT', ph: '@yourchannel' },\\n      { id: 'th', name: 'Threads', badge: 'Th', ph: '@username' },\\n      { id: 'pin', name: 'Pinterest', badge: 'P', ph: '@username' },\\n      { id: 'sp', name: 'Spotify', badge: 'Sp', ph: 'Profile link or username' },\\n      { id: 'dc', name: 'Discord', badge: 'DC', ph: 'username' },\\n      { id: 'br', name: 'BeReal', badge: 'BR', ph: '@username' },\\n      { id: 'web', name: 'Website', badge: 'Web', ph: 'yourwebsite.com' }\\n    ];\\n    const customAccounts = s.customLinks.map((c) => ({ id: c.id, name: c.name.trim() || 'Other platform or link', badge: (c.name.trim() || 'Link').slice(0, 2), handle: c.handle }));\\n    const allAccounts = PLATFORMS.map((p) => ({ id: p.id, name: p.name, badge: p.badge, handle: s.handles[p.id] || '' })).concat(customAccounts);\\n    const myAccounts = PLATFORMS.filter((p) => s.on[p.id]).map((p) => ({ id: p.id, name: p.name, badge: p.badge, handle: s.handles[p.id] || '' })).concat(customAccounts);\\n    const accName = (id) => (allAccounts.find((a) => a.id === id) || { name: id }).name;\\n\\n    const CLICKS = CLICK_DATA;\\n\\n    const FILTERS = [\\n      { id: 'hour', label: '1 hour', max: 60, phrase: 'in the last hour' },\\n      { id: 'day', label: '24 hours', max: 1440, phrase: 'in the last 24 hours' },\\n      { id: '2day', label: '2 days', max: 2880, phrase