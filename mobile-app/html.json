-direction: column; gap: 10px\\\">\\n<sc-for list=\\\"{{chat}}\\\" as=\\\"m\\\" hint-placeholder-count=\\\"2\\\">\\n<div style=\\\"{{m.wrapStyle}}\\\">\\n<div style=\\\"{{m.bubbleStyle}}\\\">{{m.text}}<\\u002Fdiv>\\n<sc-if value=\\\"{{m.hasPeople}}\\\" hint-placeholder-val=\\\"{{false}}\\\">\\n<div style=\\\"display: flex; flex-direction: column; gap: 8px; width: 100%\\\">\\n<sc-for list=\\\"{{m.people}}\\\" as=\\\"pp\\\" hint-placeholder-count=\\\"2\\\">\\n<button type=\\\"button\\\" sc-camel-on-click=\\\"{{pp.open}}\\\" style=\\\"display: flex; align-items: center; gap: 12px; box-sizing: border-box; width: 100%; padding: 10px 12px; border: 1px solid #E7DFD6; border-radius: 16px; background: #FFFFFF; cursor: pointer; text-align: left; color: #4A1A2C\\\">\\n<span style=\\\"width: 44px; height: 44px; flex: none; border-radius: 999px; background: #F5F0E8; overflow: hidden; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; font-weight: 600\\\"><sc-if value=\\\"{{pp.hasPhoto}}\\\" hint-placeholder-val=\\\"{{false}}\\\"><img src=\\\"{{pp.photo}}\\\" alt=\\\"\\\" style=\\\"width: 100%; height: 100%; object-fit: cover\\\"><\\u002Fsc-if><sc-if value=\\\"{{pp.noPhoto}}\\\" hint-placeholder-val=\\\"{{true}}\\\">{{pp.initials}}<\\u002Fsc-if><\\u002Fspan>\\n<span style=\\\"flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0\\\">\\n<span style=\\\"font-size: 15px; font-weight: 600\\\">{{pp.name}}<\\u002Fspan>\\n<span style=\\\"font-size: 12px; color: #7A5E66; line-height: 1.35\\\">{{pp.reason}}<\\u002Fspan>\\n<\\u002Fspan>\\n<svg width=\\\"16\\\" height=\\\"16\\\" sc-camel-view-box=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"#7A5E66\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" aria-hidden=\\\"true\\\" style=\\\"flex: none\\\"><path d=\\\"M9 6l6 6-6 6\\\"><\\u002Fpath><\\u002Fsvg>\\n<\\u002Fbutton>\\n<\\u002Fsc-for>\\n<\\u002Fdiv>\\n<\\u002