 }); return; }\\n        if (st.editId && st.presets.some((p) => p.id === st.editId)) {\\n          this.setState({ presets: st.presets.map((p) => (p.id === st.editId ? Object.assign({}, p, { name: name, plats: plats }) : p)), screen: st.editReturn });\\n        } else {\\n          const id = 'custom' + Date.now();\\n          this.setState({ presets: st.presets.concat([{ id: id, name: name, plats: plats, custom: true }]), activePreset: id, screen: st.editReturn });\\n        }\\n      },\\n      deleteEdit: () => {\\n        const st = this.state;\\n        const rest = st.presets.filter((p) => p.id !== st.editId);\\n        this.setState({ presets: rest, activePreset: st.activePreset === st.editId ? rest[0].id : st.activePreset, screen: st.editReturn });\\n      },\\n\\n      filters, clicks,\\n      noClicks: clicks.length === 0,\\n      countText: clicks.length + (clicks.length === 1 ? ' Click ' : ' Clicks ') + activeFilter.phrase,\\n\\n      person,\\n      editingLoc: s.editingLoc,\\n      notEditingLoc: !s.editingLoc,\\n      locDraft: s.locDraft,\\n      onLocDraft: (e) => this.setState({ locDraft: e.target.value }),\\n      startEditLoc: set({ editingLoc: true, locDraft: selEvent || '' }),\\n      cancelEditLoc: set({ editingLoc: false }),\\n      saveLoc: () => this.setState({ editingLoc: false, events: Object.assign({}, s.events, { [sel.id]: s.locDraft.trim() }) }),\\n      noteText: s.notes[sel.id] || '',\\n      onNote: (e) => this.setState({ notes: Object.assign({}, s.notes, { [sel.id]: e.target.value }) }),\\n      removeClick: () => this.setState({ removed: Object.assign({}, s.removed, { [sel.id]: true }), screen: 'clicks' }),\\n\\n      currentEvent: s.currentEvent,\\n      onCurrentEvent: (e) => this.setState({ currentEvent: e.target.value }),\\n      durations,\\n      isWindow: s.eventDur === 'window',\\n      winStart: s.winStart, winEnd: s.winEnd, winTz: s.winTz,\\n      onWinStart: (e) => this.setState({ winStart: e.target.value }),\\n      onWinEnd: (e) => this.setState({ winEnd: e.target.value }),\\n      onWinTz: (e) => this.setState({ winTz: e.target.value }),\\n      evName: evName,\\n      hasEvent: !!evName,\\n      eventStatus: 'New Clicks will be saved at ' + evName + ' ' + whenText + '. Outside that, Click uses your general location.',\\n\\n      braceletStatus: s.locked ? 'Locked · Not sharing' : 'Connected via Bluetooth',\\n      toggleSound: set({ sound: !s.sound }),\\n      soundTrack: trackStyle(s.sound), soundKnob: knobStyle(),\\n      toggleLock: set({ locked: !s.locked }),\\n      lockTrack: trackStyle(s.locked), lockKnob: knobStyle(),\\n      editProfile: set({ screen: 'profile', fromSettings: true }),\\n      editSocials: set({ screen: 'socials', fromSettings: true }),\\n      repair: set({ screen: 'pair', fromSettings: true, pairState: 'idle' }),\\n      signOut: () => {\\n        if (window.ReactNativeWebView) window.ReactNativeWebView.postMessage('sign-out');\\n        set({ screen: 'welcome', fromSettings: false, pairState: 'idle', filter: 'year', removed: {}, events: {}, notes: {}, expandedId: null, chat: [], chatDraft: '' })();\\n      },\\n\\n      tabClicks: set({ screen: 'clicks', editingLoc: false }),\\n      tabPresets: set({ screen: 'presets' }),\\n      tabSettings: set({ screen: 'settings', fromSettings: false }),\\n      tabClicksStyle: tabStyle(sc === 'clicks' || sc === 'person'),\\n      tabPresetsStyle: tabStyle(sc === 'presets' || sc === 'editPreset'),\\n      tabSettingsStyle: tabStyle(sc === 'settings')\\n    };\\n  }\\n}\\n<\\u002Fscript>\\n\\n\\n<\\u002Fbody><\\u002Fhtml>\"\n  </script>\n</body>\n</html>\n"
